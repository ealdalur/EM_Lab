#version 460 core
// clear_fields.comp - zero E and B while preserving the material alpha channels.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

layout(binding = 0, rgba32f) uniform restrict image3D uEField;
layout(binding = 1, rgba32f) uniform restrict image3D uBField;

uniform ivec3 uGridSize;

void main() {
    ivec3 p = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(p, uGridSize))) return;
    imageStore(uEField, p, vec4(0.0, 0.0, 0.0, imageLoad(uEField, p).w));
    imageStore(uBField, p, vec4(0.0, 0.0, 0.0, imageLoad(uBField, p).w));
}
