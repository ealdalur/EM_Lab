#version 460 core
// =============================================================================
// port_accumulate.comp - antenna feed ports: gap voltage and terminal current.
//
// A port is the feed gap of an antenna: one Yee E edge along `axis` (thin wire) or the
// four edges at the corners of one cell (1x1-cell rod), oriented by `sign`.
//   V = E_axis * dx                     (gap voltage, averaged over the port's edges)
//   I = sum over the edges of (curl B)_axis * dx^2
//     = the loop integral of H around the gap: the total current through it, which by
//       continuity is the current flowing into the antenna's arms.
// Both are turned into complex amplitudes at the analysis frequency with the same
// two-stage running DFT as the far-field monitor (E sampled at t, B at t - dt/2).
// =============================================================================

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) uniform sampler3D uEField;
layout(binding = 1) uniform sampler3D uBField;

struct Port {
    ivec4 texelAxis; // xyz = owning texel of the (first) gap edge, w = axis
    ivec4 info;      // x = edge count (1 or 4), y = sign (+1 / -1)
};
struct PortPhasor {
    vec4 stage1;     // (V re, V im, I re, I im)
    vec4 stage2;
};

layout(std430, binding = 6) readonly restrict buffer PortBuffer { Port uPorts[]; };
layout(std430, binding = 7) restrict buffer PortPhasorBuffer { PortPhasor uPhasors[]; };

uniform ivec3 uGridSize;
uniform int   uPortCount;
uniform vec4  uRotation; // (cos w t_E, sin w t_E, cos w t_H, sin w t_H)
uniform float uBlend;    // per-stage EMA weight

vec4 fetchE(ivec3 p) { return texelFetch(uEField, clamp(p, ivec3(0), uGridSize - 1), 0); }
vec4 fetchB(ivec3 p) { return texelFetch(uBField, clamp(p, ivec3(0), uGridSize - 1), 0); }

ivec3 unitVec(int a) { ivec3 e = ivec3(0); e[a] = 1; return e; }

// (curl B)_a on the a-edge owned by texel p: current through the edge's dual face.
float edgeCurrent(ivec3 p, int a) {
    int u = (a + 1) % 3, v = (a + 2) % 3;
    vec4 b0 = fetchB(p), bu = fetchB(p - unitVec(u)), bv = fetchB(p - unitVec(v));
    return (b0[v] - bu[v]) - (b0[u] - bv[u]);
}

void main() {
    int i = int(gl_GlobalInvocationID.x);
    if (i >= uPortCount) return;

    Port port = uPorts[i];
    ivec3 p = port.texelAxis.xyz;
    int a = port.texelAxis.w;
    float s = float(port.info.y);

    float V = 0.0, I = 0.0;
    if (port.info.x == 4) {
        ivec3 eu = unitVec((a + 1) % 3), ev = unitVec((a + 2) % 3);
        ivec3 offs[4] = ivec3[4](ivec3(0), eu, ev, eu + ev);
        for (int k = 0; k < 4; ++k) {
            V += 0.25 * fetchE(p + offs[k])[a];
            I += edgeCurrent(p + offs[k], a);
        }
    } else {
        V = fetchE(p)[a];
        I = edgeCurrent(p, a); // current through the feed gap itself (the feed point)
    }
    V *= s;
    I *= s;

    vec4 obs = vec4(2.0 * uRotation.x * V, -2.0 * uRotation.y * V,
                       2.0 * uRotation.z * I, -2.0 * uRotation.w * I);
    PortPhasor ph = uPhasors[i];
    ph.stage1 += uBlend * (obs - ph.stage1);
    ph.stage2 += uBlend * (ph.stage1 - ph.stage2);
    uPhasors[i] = ph;
}
