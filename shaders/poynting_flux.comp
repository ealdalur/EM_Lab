#version 460 core
// =============================================================================
// poynting_flux.comp - power through an axis-aligned rectangle:
//
//     P = sum over cells of  S . n  dA,    S = E x B  (normalised units, dA = 1)
//
// E and B live on different staggered sub-positions of the Yee cell, so both
// are interpolated to the integer lattice node (i,j,k) before the cross product.
// Each 16x16 workgroup reduces its tile in shared memory and writes one partial
// sum; the CPU adds the (few hundred) partials in double precision. This avoids
// float atomics, which are not core in GL 4.6.
// =============================================================================

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0) uniform sampler3D uEField;
layout(binding = 1) uniform sampler3D uBField;

layout(std430, binding = 2) writeonly restrict buffer PartialSums { float uPartials[]; };

uniform ivec3 uGridSize;
uniform int   uAxis;       // plane normal axis: 0 = x, 1 = y, 2 = z
uniform int   uPlaneIndex; // lattice index of the plane along uAxis
uniform ivec2 uRectMin;    // first cell along the two tangential axes (u, v)
uniform ivec2 uRectSize;   // number of cells along (u, v)

shared float sPartial[256];

#include "field_sampling.glsl"

void main() {
    ivec2 local = ivec2(gl_GlobalInvocationID.xy);
    uint  lid   = gl_LocalInvocationIndex;

    float flux = 0.0;
    if (all(lessThan(local, uRectSize))) {
        ivec2 uv = uRectMin + local;
        ivec3 p;
        if (uAxis == 0)      p = ivec3(uPlaneIndex, uv.x, uv.y);
        else if (uAxis == 1) p = ivec3(uv.x, uPlaneIndex, uv.y);
        else                 p = ivec3(uv.x, uv.y, uPlaneIndex);

        if (all(greaterThanEqual(p, ivec3(0))) && all(lessThan(p, uGridSize))) {
            vec3 S = cross(eAtNode(p), bAtNode(p));
            flux = S[uAxis];
        }
    }

    sPartial[lid] = flux;
    memoryBarrierShared();
    barrier();
    // Tree reduction, unrolled so every barrier() sits in straight-line code.
#define REDUCE_STEP(STRIDE)                                               if (lid < STRIDE##u) sPartial[lid] += sPartial[lid + STRIDE##u];     memoryBarrierShared();                                                barrier();
    REDUCE_STEP(128) REDUCE_STEP(64) REDUCE_STEP(32) REDUCE_STEP(16)
    REDUCE_STEP(8)   REDUCE_STEP(4)  REDUCE_STEP(2)  REDUCE_STEP(1)
#undef REDUCE_STEP

    if (lid == 0u) {
        uint group = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
        uPartials[group] = sPartial[0];
    }
}
